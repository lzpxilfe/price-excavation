# 메타데이터 절대 URL. 공개값이며 로컬 개발 기본값은 아래와 같습니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 아래 값은 서버 전용 비밀값입니다. NEXT_PUBLIC_ 접두사를 붙이거나 Git에 커밋하지 마세요.

# VWorld 주소 검색 및 연속지적도 조회
VWORLD_API_KEY=

# 공공데이터포털 기상청 ASOS 일자료 조회용 일반 인증키
DATA_GO_KR_SERVICE_KEY=

# Kakao Mobility 자동차 길찾기 REST API 키
KAKAO_MOBILITY_REST_KEY=
